# Supabase (Project Settings > API). The service role key is SECRET, never put it in the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Solana network. Start with devnet (fake SOL), switch to mainnet only after testing.
SOLANA_RPC=https://api.devnet.solana.com

# The wallet address that receives pack payments (a separate wallet just for the shop).
SHOP_WALLET=

# Any long random text, used to sign login tokens.
JWT_SECRET=
